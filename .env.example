# .env.example - connection template for local-data-platform
# Copy this file to `.env` and adjust values as needed.
# `.env` is git-ignored; this template is committed.
# docker-compose.yml reads ${VAR:-default}, so defaults work even without .env.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics
# dbt / load_raw_data.py / smoke_test.py が使うアプリ用ユーザ。
# Terraform で作成される dbt_user (raw/staging/intermediate/marts のオーナー)。
# Postgres 側の superuser (analytics_user / analytics_password) は docker-compose と
# Terraform 内部接続が直接読むため、ここでは設定しない。
DB_USER=dbt_user
DB_PASSWORD=dbt_password

# --- Metabase bootstrap (scripts/metabase_bootstrap.py) ---
# Used only by the bootstrap script. Metabase itself reads its own state from
# the metabase_data volume (H2). Re-run the script after changing values.
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@local.test
# Must satisfy Metabase: length>=6, contains upper + lower + digit + symbol.
# password is set in .env (gitignored)
METABASE_ADMIN_FIRST=Local
METABASE_ADMIN_LAST=Admin
METABASE_SITE_NAME=local-data-platform
METABASE_SITE_LOCALE=ja
METABASE_DB_NAME=local-analytics
METABASE_DB_RO_USER=readonly_user
# password is set in .env (gitignored)
